# Copy to .env and fill in. Generate keys at https://aistudio.google.com/apikey

# Free-tier keys are capped per day per model, and one full backfill needs more
# than a single key allows. Add as many as you have (up to _8); the client moves
# to the next one when a key is rate limited or rejected.
GOOGLE_API_KEY_1=your-first-key
GOOGLE_API_KEY_2=your-second-key
GOOGLE_API_KEY_3=your-third-key

# Fallback if none of the numbered keys above are set.
# GOOGLE_API_KEY=your-api-key-here

# Optional: override the default model (gemini-3.7-flash)
# GEMINI_MODEL=gemini-3.7-flash

# Postgres connection string for the visits / visit_insights tables.
CONNSTR=postgresql://user:password@host/dbname?sslmode=require

# Shared secret. When set, every route except GET /health requires a matching
# X-API-Key header. Leave unset for local development and the API stays open.
# Narrow CORS_ORIGINS before enabling this: "*" cannot be combined with
# credentialed requests.
# API_KEY=a-long-random-string

# Comma-separated allowed origins. Defaults to "*", which is fine locally and
# wrong anywhere else.
# CORS_ORIGINS=http://localhost:3000

# Upload ceiling for transcripts, in bytes. Default 262144 (256 KB); real
# transcripts are 3-5 KB.
# MAX_TRANSCRIPT_BYTES=262144
