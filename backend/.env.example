# Copy to .env and fill in. Generate keys at https://aistudio.google.com/apikey

# Free-tier keys are capped per day per model, and one full backfill needs more
# than a single key allows. Add as many as you have (up to _8); the client moves
# to the next one when a key is rate limited or rejected.
GOOGLE_API_KEY_1=your-first-key
GOOGLE_API_KEY_2=your-second-key
GOOGLE_API_KEY_3=your-third-key

# Fallback if none of the numbered keys above are set.
# GOOGLE_API_KEY=your-api-key-here

# Optional: override the default model (gemini-3.7-flash)
# GEMINI_MODEL=gemini-3.7-flash

# Postgres connection string for the visits / visit_insights tables.
CONNSTR=postgresql://user:password@host/dbname?sslmode=require

# Shared secret. When set, every route except GET /health requires a matching
# X-API-Key header. Leave unset for local development and the API stays open.
# Narrow CORS_ORIGINS before enabling this: "*" cannot be combined with
# credentialed requests.
# API_KEY=a-long-random-string

# Comma-separated allowed origins. Defaults to "*", which is fine locally and
# wrong anywhere else.
# CORS_ORIGINS=http://localhost:3000

# Upload ceiling for transcripts, in bytes. Default 262144 (256 KB); real
# transcripts are 3-5 KB.
# MAX_TRANSCRIPT_BYTES=262144
# ---------------------------------------------------------------------------
# Transcript storage
#
# Where NEW uploads are written. Existing visits are unaffected: each one records
# its own backend in visits.transcript_provider and is read back through that,
# so changing this never orphans anything already stored. Moving old transcripts
# across is an explicit, verified step:
#
#   python -m cli.migrate_transcripts --status
#   python -m cli.migrate_transcripts --to neon_object_storage --dry-run
#   python -m cli.migrate_transcripts --to neon_object_storage
#   python -m cli.migrate_transcripts --verify
#
# 'local' keeps transcripts in backend/transcripts/ and needs no credentials, so
# a fresh checkout works offline. 'neon_object_storage' needs the four AWS_*
# values below.
# TRANSCRIPT_STORAGE=local

# Bucket name. Must already exist — create it in the Neon Console under the
# branch's Object storage tab, or with `neon buckets create`. Keep it private:
# these are consultation transcripts, never public_read.
# TRANSCRIPT_BUCKET=consultation-transcripts

# Neon Object Storage credential, in AWS-standard variable names so `neon env
# pull` writes them directly and boto3 would find them anyway.
#
# Create one in the Neon Console: branch -> Credentials -> Create credential,
# with the storage:read AND storage:write scopes. The secret is shown ONCE and
# cannot be retrieved afterwards — copy it before closing the dialog.
#
# Credentials are branch-scoped: one minted on `production` works on production
# and any branch forked from it, and is rejected elsewhere. So a branch outside
# that lineage needs its own, and AWS_ENDPOINT_URL_S3 differs per branch too.
#
# AWS_ACCESS_KEY_ID is the credential's `token_id`, and AWS_SECRET_ACCESS_KEY is
# its `s3_secret_access_key`.
# AWS_ENDPOINT_URL_S3=https://br-xxxxxxxx.storage.c-4.us-east-2.aws.neon.tech
# AWS_ACCESS_KEY_ID=nak_live_...
# AWS_SECRET_ACCESS_KEY=nsk_live_...
# AWS_REGION=us-east-2
