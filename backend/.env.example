# Copy to .env and fill in. Secrets only: every other setting (provider, models,
# limits, storage backend) lives in config.yaml, which reads these by name as
# ${NAME}. On a host without a .env file, set the same names as environment
# variables. backend/.env wins over a variable already exported in the shell.

# ---------------------------------------------------------------------------
# Model providers. One key each; llm.provider in config.yaml picks which one is
# used. Only the selected provider's key is required.
#
# Gemini: create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key

# Amazon Bedrock: create an API key in the Bedrock console (API keys). It is sent
# as a bearer token; the region and model are in config.yaml under llm.bedrock.
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key

# Check the selected provider's key with: python -m cli.check_keys
# ---------------------------------------------------------------------------
# Speech-to-text for audio uploads. Recordings are transcribed by Deepgram with
# speaker diarization; model, language and region are in config.yaml under
# speech.deepgram. Only needed if audio uploads are used: without it, text
# uploads work and an audio upload is refused with a message naming this key.
#
# Create a key at https://console.deepgram.com -> API Keys.
DEEPGRAM_API_KEY=your-deepgram-api-key

# ---------------------------------------------------------------------------
# Postgres connection string for the visits / visit_insights tables.
CONNSTR=postgresql://user:password@host/dbname?sslmode=require

# Shared secret. When set, every route except GET /health requires a matching
# X-API-Key header. Leave unset for local development and the API stays open.
# Must match BACKEND_API_KEY in frontend/.env.local.
# Narrow CORS_ORIGINS before enabling this: "*" cannot be combined with
# credentialed requests.
# API_KEY=a-long-random-string

# Allowed browser origins. Leave unset locally: it defaults to "*". Set it on the
# server to the deployed frontend origin. A bare value, a comma-separated list,
# or a JSON list all work:
#   CORS_ORIGINS=https://myapp.vercel.app
#   CORS_ORIGINS=https://myapp.vercel.app,http://localhost:5173
#
# An origin is scheme + host + port only. No path, and a trailing slash is
# stripped for you. http://localhost:5173 and http://127.0.0.1:5173 are
# different origins to a browser.
# CORS_ORIGINS=https://myapp.vercel.app

# ---------------------------------------------------------------------------
# Neon Object Storage credential for transcripts, used when transcripts.storage
# in config.yaml is neon_object_storage. AWS-standard names, so `neon env pull`
# writes them directly.
#
# Create one in the Neon Console: branch -> Credentials -> Create credential,
# with the storage:read AND storage:write scopes. The secret is shown ONCE and
# cannot be retrieved afterwards; copy it before closing the dialog.
#
# Credentials are branch-scoped: one minted on `production` works on production
# and any branch forked from it, and is rejected elsewhere. So a branch outside
# that lineage needs its own, and AWS_ENDPOINT_URL_S3 differs per branch too.
#
# AWS_ACCESS_KEY_ID is the credential's `token_id`, and AWS_SECRET_ACCESS_KEY is
# its `s3_secret_access_key`. AWS_REGION defaults to us-east-2.
# AWS_ENDPOINT_URL_S3=https://br-xxxxxxxx.storage.c-4.us-east-2.aws.neon.tech
# AWS_ACCESS_KEY_ID=nak_live_...
# AWS_SECRET_ACCESS_KEY=nsk_live_...
# AWS_REGION=us-east-2
