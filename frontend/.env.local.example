# ---------------------------------------------------------------------------
# Consultation Insights — frontend environment
#
# Copy to .env.local and fill in. .env.local is gitignored; this template is not.
#
#   cp .env.local.example .env.local
#
# NOTHING HERE IS SAFE TO EXPOSE. Every variable below is server-only, and that
# is deliberate: the browser talks only to same-origin /api/v1/... and the
# server-side BFF (app/api/[...path]/route.ts) holds the credentials.
#
# Next.js only ships a variable to the browser if its name begins with
# NEXT_PUBLIC_. There are no NEXT_PUBLIC_ variables in this project, and adding
# one for the backend URL or either key would defeat the BFF entirely.
# ---------------------------------------------------------------------------


# --- Neon Auth (server-only) ----------------------------------------------- #

# Your Managed Better Auth server URL.
# Neon Console -> project -> branch -> Auth -> Configuration -> Auth URL.
# Looks like this:
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth

# Signs the cached session cookie (HMAC-SHA256). Must be 32+ characters.
# This is yours to generate, not something to copy from the console:
#
#   openssl rand -base64 32
#
NEON_AUTH_COOKIE_SECRET=


# --- FastAPI backend (server-only) ----------------------------------------- #

# Where the FastAPI service listens. Only the Next.js server reaches this; the
# browser never does. Origin only — no /api/v1 suffix, because the generated
# OpenAPI paths already include it and the proxy forwards them unchanged.
BACKEND_URL=http://127.0.0.1:8000

# The backend's shared API key. Must match API_KEY in backend/.env, which is
# currently set, so the API rejects requests without this header.
# The BFF attaches it as X-API-Key on every forwarded request.
BACKEND_API_KEY=
